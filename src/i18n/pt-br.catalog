;;;; Portuguese (Brazil) translations. Each entry is (ENGLISH TRANSLATION); the English text is the key.
;;;; A translation asks for the same format directives, in the same order, as its English text.
;;;; The file is UTF-8 data: it is read, never evaluated.

(:language :pt-br
 :name "Português (Brasil)"
 :entries
 (
  ;; Title bar and files
  ("Language" "Idioma")
  ("Language: ~a" "Idioma: ~a")
  ("New drawing" "Novo desenho")
  ("Open a drawing" "Abrir um desenho")
  ("Save" "Salvar")
  ("Save as..." "Salvar como...")
  ("Undo" "Desfazer")
  ("Redo" "Refazer")
  ("Performance overlay" "Painel de desempenho")
  ("Untitled" "Sem título")
  ("(unnamed)" "(sem nome)")

  ;; Palette and menus
  ("Select and move" "Selecionar e mover")
  ("Drawing tools" "Ferramentas de desenho")
  ("Line" "Linha")
  ("Polyline" "Polilinha")
  ("Rectangle" "Retângulo")
  ("Circle" "Círculo")
  ("Text" "Texto")
  ("Dimension" "Cota")

  ;; Names of the kinds of entity, in messages
  ("line" "linha")
  ("rectangle" "retângulo")
  ("circle" "círculo")
  ("polyline" "polilinha")
  ("text" "texto")
  ("dimension" "cota")

  ;; Empty drawing
  ("Start drawing" "Comece a desenhar")
  ("Pick a tool on the left, or press L for a line, R for a rectangle, C for a circle."
   "Escolha uma ferramenta à esquerda, ou tecle L para linha, R para retângulo, C para círculo.")
  ("Ctrl+O opens a drawing, and a .bcad file dropped on the window opens too."
   "Ctrl+O abre um desenho; um arquivo .bcad solto na janela também abre.")

  ;; Prompts of the tools
  ("Select: click an entity, drag it to move, drag on empty space to select a window (Shift adds)."
   "Selecionar: clique em uma entidade, arraste para mover ou no vazio para selecionar uma janela (Shift soma).")
  ("Line: click the start point" "Linha: clique no ponto inicial")
  ("Line: click the end point (Esc cancels)" "Linha: clique no ponto final (Esc cancela)")
  ("Rectangle: click the first corner" "Retângulo: clique no primeiro canto")
  ("Rectangle: click the opposite corner (Esc cancels)" "Retângulo: clique no canto oposto (Esc cancela)")
  ("Circle: click the center" "Círculo: clique no centro")
  ("Circle: click a point on the circle (Esc cancels)" "Círculo: clique em um ponto do círculo (Esc cancela)")
  ("Polyline: click the first vertex" "Polilinha: clique no primeiro vértice")
  ("Polyline: click vertices; Enter finishes; click the first vertex to close; Backspace removes the last"
   "Polilinha: clique nos vértices; Enter conclui; clique no primeiro vértice para fechar; Backspace remove o último")
  ("Text: click where the text starts" "Texto: clique onde o texto começa")
  ("Text to place at the clicked point:" "Texto a colocar no ponto clicado:")
  ("Dimension: click the first point" "Cota: clique no primeiro ponto")
  ("Dimension: click the second point (Esc cancels)" "Cota: clique no segundo ponto (Esc cancela)")
  ("Dimension: click to place the dimension line (Esc cancels)"
   "Cota: clique para posicionar a linha de cota (Esc cancela)")
  ("That vertex is already placed." "Esse vértice já foi colocado.")
  ("A polyline needs at least two vertices." "Uma polilinha precisa de pelo menos dois vértices.")
  ("The two points must be apart." "Os dois pontos devem estar afastados.")
  ("Moved ~d.~a" "Movidas: ~d.~a")

  ;; Status bar
  ("Grid" "Grade")
  ("Snap" "Snap")
  ("OSnap" "OSnap")
  ("Fit" "Ajustar")
  ("Unit: ~a" "Unidade: ~a")
  ("Show the grid" "Mostrar a grade")
  ("Snap to the grid" "Capturar a grade")
  ("Snap to endpoints and centers" "Capturar extremidades e centros")
  ("Change the display unit" "Mudar a unidade de exibição")
  ("Zoom to fit everything" "Ajustar o zoom para mostrar tudo")
  ("X ~a  Y ~a ~a | ~a~@[ | snap: ~a~]" "X ~a  Y ~a ~a | ~a~@[ | captura: ~a~]")
  ("endpoint" "extremidade")
  ("center" "centro")
  ("grid" "grade")

  ;; Layers
  ("Layers" "Camadas")
  ("Layer" "Camada")
  ("Show or hide the layer" "Mostrar ou ocultar a camada")
  ("Lock or unlock the layer" "Bloquear ou desbloquear a camada")
  ("Create a layer" "Criar uma camada")
  ("New layer" "Nova camada")
  ("Layer name:" "Nome da camada:")
  ("Rename" "Renomear")
  ("Rename layer" "Renomear camada")
  ("New name:" "Novo nome:")
  ("Rename the current layer" "Renomear a camada atual")
  ("Delete" "Excluir")
  ("Delete the current layer if it is empty" "Excluir a camada atual se estiver vazia")
  ("Color" "Cor")
  ("Change the color of the current layer" "Mudar a cor da camada atual")
  ("Click to make this the current layer" "Clique para tornar esta a camada atual")
  ("Layer renamed." "Camada renomeada.")
  ("Layer ~s created and selected." "Camada ~s criada e selecionada.")
  ("Layer ~s deleted; undo history cleared." "Camada ~s excluída; histórico de desfazer limpo.")
  ("layer ~s is hidden; show it or choose another layer"
   "a camada ~s está oculta; mostre-a ou escolha outra camada")
  ("layer ~s is locked; unlock it or choose another layer"
   "a camada ~s está bloqueada; desbloqueie-a ou escolha outra camada")
  ("layer ~s still holds ~d ~:*~[entities~;entity~:;entities~]; move or delete them first"
   "a camada ~s ainda tem ~d ~:*~[entidades~;entidade~:;entidades~]; mova ou exclua-as antes")
  ("a layer named ~s already exists" "já existe uma camada chamada ~s")
  ("the default layer cannot be deleted" "a camada padrão não pode ser excluída")
  ("the layer name cannot be empty" "o nome da camada não pode ficar vazio")
  ("the layer name is longer than ~d characters" "o nome da camada tem mais de ~d caracteres")
  ("there is no layer with id ~d" "não há camada com o id ~d")
  ("layer id ~d is used twice" "o id de camada ~d é usado duas vezes")
  ("Layer error: ~a" "Erro de camada: ~a")

  ;; Properties
  ("Properties" "Propriedades")
  ("Drawing" "Desenho")
  ("Selection" "Seleção")
  ("Entity" "Entidade")
  ("~a #~d" "~a #~d")
  ("~d entities selected" "~d entidades selecionadas")
  ("~d ~:*~[entities~;entity~:;entities~], ~d ~:*~[layers~;layer~:;layers~]"
   "~d ~:*~[entidades~;entidade~:;entidades~], ~d ~:*~[camadas~;camada~:;camadas~]")
  ("Grid spacing" "Espaçamento da grade")
  ("Text height" "Altura do texto")
  ("Select an entity to edit it." "Selecione uma entidade para editá-la.")
  ("(several)" "(várias)")
  ("Click to move the selection to the next layer" "Clique para mover a seleção para a próxima camada")
  ("Click to toggle" "Clique para alternar")
  ("Click to change the unit" "Clique para mudar a unidade")
  ("Click to edit; Enter commits, Esc cancels" "Clique para editar; Enter confirma, Esc cancela")
  ("Yes" "Sim")
  ("No" "Não")
  ("Center X" "Centro X")
  ("Center Y" "Centro Y")
  ("Radius" "Raio")
  ("Diameter" "Diâmetro")
  ("Circumference" "Circunferência")
  ("Area" "Área")
  ("Perimeter" "Perímetro")
  ("Left" "Esquerda")
  ("Bottom" "Inferior")
  ("Width" "Largura")
  ("Height" "Altura")
  ("Start X" "Início X")
  ("Start Y" "Início Y")
  ("End X" "Fim X")
  ("End Y" "Fim Y")
  ("Length" "Comprimento")
  ("Angle" "Ângulo")
  ("Closed" "Fechada")
  ("Vertices" "Vértices")
  ("Vertex ~d X" "Vértice ~d X")
  ("Vertex ~d Y" "Vértice ~d Y")
  ("X" "X")
  ("Y" "Y")
  ("Point 1 X" "Ponto 1 X")
  ("Point 1 Y" "Ponto 1 Y")
  ("Point 2 X" "Ponto 2 X")
  ("Point 2 Y" "Ponto 2 Y")
  ("Offset" "Afastamento")
  ("Unit" "Unidade")
  ("Decimals" "Decimais")
  ("Measured length" "Comprimento medido")

  ;; Operations
  ("Nothing is selected." "Nada está selecionado.")
  ("The selected entities are on locked layers." "As entidades selecionadas estão em camadas bloqueadas.")
  ("Deleted ~d ~:*~[entities~;entity~:;entities~].~a"
   "~d ~:*~[entidades excluídas~;entidade excluída~:;entidades excluídas~].~a")
  (" (~d on locked layers were left unchanged)" " (~d em camadas bloqueadas não foram alteradas)")
  ("Undone." "Desfeito.")
  ("Nothing to undo." "Nada para desfazer.")
  ("Redone." "Refeito.")
  ("Nothing to redo." "Nada para refazer.")
  ("~d selected." "Selecionadas: ~d.")
  ("Moved ~d to layer ~s.~a" "Movidas ~d para a camada ~s.~a")
  ("Property changed." "Propriedade alterada.")
  ("Copied ~d ~:*~[entities~;entity~:;entities~]."
   "~d ~:*~[entidades copiadas~;entidade copiada~:;entidades copiadas~].")
  ("Cut ~d ~:*~[entities~;entity~:;entities~]."
   "~d ~:*~[entidades recortadas~;entidade recortada~:;entidades recortadas~].")
  ("Pasted ~d ~:*~[entities~;entity~:;entities~]."
   "~d ~:*~[entidades coladas~;entidade colada~:;entidades coladas~].")
  ("Nothing to paste: the clipboard has no drawing entities."
   "Nada para colar: a área de transferência não tem entidades de desenho.")
  ("Lengths are now shown in ~a." "Os comprimentos agora aparecem em ~a.")
  ("expected a whole number" "esperava um número inteiro")
  ("unknown unit; use mm, cm or m" "unidade desconhecida; use mm, cm ou m")
  ("unknown unit ~s; use mm, cm or m" "unidade ~s desconhecida; use mm, cm ou m")
  ("not a number; enter digits with an optional sign and decimal point"
   "não é um número; digite algarismos com sinal e ponto decimal opcionais")
  ("New drawing." "Novo desenho.")
  ("Unsaved changes" "Alterações não salvas")
  ("The drawing has changes that are not saved." "O desenho tem alterações que não foram salvas.")
  ("Discard" "Descartar")
  ("Cancel" "Cancelar")
  ("OK" "OK")
  ("Opened ~a: ~d ~:*~[entities~;entity~:;entities~] (~a)."
   "~a aberto: ~d ~:*~[entidades~;entidade~:;entidades~] (~a).")
  ("Saved ~a (~a)." "~a salvo (~a).")

  ;; Errors
  ("Invalid ~a: ~a" "Entidade inválida (~a): ~a")
  ("Invalid input ~s: ~a" "Entrada inválida ~s: ~a")
  ("Internal error while ~a: ~a. ~a" "Erro interno ao ~a: ~a. ~a")
  ("handling input" "tratar a entrada")
  ("drawing the window" "desenhar a janela")
  ("Save your work and restart if things look wrong; the log has the details."
   "Salve seu trabalho e reinicie se algo parecer errado; o registro tem os detalhes.")
  ("Drawing file ~a: ~a" "Arquivo de desenho ~a: ~a")
  ("Drawing file ~a, line ~d, column ~d: ~a" "Arquivo de desenho ~a, linha ~d, coluna ~d: ~a")
  ("entity ~d does not exist" "a entidade ~d não existe")
  ("entity ~d is on a locked layer" "a entidade ~d está em uma camada bloqueada")
  ("the grid spacing must be between ~f and ~f mm" "o espaçamento da grade deve ficar entre ~f e ~f mm")
  ("the text height must be a positive length" "a altura do texto deve ser um comprimento positivo")
  ("the id must be a positive integer, got ~s" "o id deve ser um inteiro positivo, mas é ~s")
  ("the layer id must be a non-negative integer, got ~s" "o id da camada deve ser um inteiro não negativo, mas é ~s")
  ("~a must be a number between -~f and ~f mm, got ~a" "~a deve ser um número entre -~f e ~f mm, mas é ~a")
  ("~a must be a number above ~f mm, got ~a" "~a deve ser um número acima de ~f mm, mas é ~a")
  ("it extends beyond the drawing limit of ~f mm" "ultrapassa o limite do desenho de ~f mm")
  ("its length is ~f mm; a line needs a length above ~f mm"
   "seu comprimento é ~f mm; uma linha precisa de comprimento acima de ~f mm")
  ("its definition points are ~f mm apart; they must be more than ~f mm apart"
   "seus pontos de definição estão a ~f mm; devem estar a mais de ~f mm")
  ("its unit must be one of ~{~(~a~)~^, ~}, got ~s" "sua unidade deve ser uma entre ~{~(~a~)~^, ~}, mas é ~s")
  ("its precision must be between 0 and ~d decimals, got ~s" "sua precisão deve ficar entre 0 e ~d decimais, mas é ~s")
  ("its coordinates must be a sequence, got ~s" "suas coordenadas devem ser uma sequência, mas recebeu ~s")
  ("its coordinates must come in x/y pairs" "suas coordenadas devem vir em pares x/y")
  ("coordinate ~d" "coordenada ~d")
  ("it has ~d vertices; a ~:[open~;closed~] polyline needs at least ~d"
   "tem ~d vértices; uma polilinha ~:[aberta~;fechada~] precisa de pelo menos ~d")
  ("it has ~d vertices; the limit is ~d" "tem ~d vértices; o limite é ~d")
  ("vertices ~d and ~d coincide; consecutive vertices must be at least ~f mm apart"
   "os vértices ~d e ~d coincidem; vértices consecutivos devem ficar a pelo menos ~f mm")
  ("the text must be 1 to ~d characters without control characters"
   "o texto deve ter de 1 a ~d caracteres, sem caracteres de controle")

  ;; Files
  ("is a folder; type a file name" "é uma pasta; digite um nome de arquivo")
  ("is a folder, not a file" "é uma pasta, não um arquivo")
  ("cannot be saved: the folder ~a does not exist" "não pode ser salvo: a pasta ~a não existe")
  ("cannot be saved: the folder is not writable (permission denied)"
   "não pode ser salvo: não há permissão para gravar na pasta")
  ("cannot be saved: the file is read-only" "não pode ser salvo: o arquivo é somente leitura")
  ("cannot be written: ~a" "não pode ser gravado: ~a")
  ("does not exist" "não existe")
  ("is a folder, not a drawing file" "é uma pasta, não um arquivo de desenho")
  ("is not a regular file" "não é um arquivo comum")
  ("cannot be opened: permission denied" "não pode ser aberto: permissão negada")
  ("is larger than the ~d MiB limit" "é maior que o limite de ~d MiB")
  ("cannot be opened: ~a" "não pode ser aberto: ~a")
  ("is not a text file that Borba CAD can read (it must be UTF-8 text): ~a"
   "não é um arquivo de texto que o Borba CAD consiga ler (precisa ser texto UTF-8): ~a")
  ("type the name of a file" "digite o nome de um arquivo")

