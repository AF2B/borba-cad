  ("Modified" "Modificado")
  ("File name" "Nome do arquivo")
  ("All files" "Todos os arquivos")
  ("List every file, not only drawings" "Listar todos os arquivos, não só os desenhos")
  ("New folder" "Nova pasta")
  ("Create a folder here" "Criar uma pasta aqui")
  ("Name of the new folder:" "Nome da nova pasta:")
  ("Type a name for the folder." "Digite um nome para a pasta.")
  ("Type a name for the file." "Digite um nome para o arquivo.")
