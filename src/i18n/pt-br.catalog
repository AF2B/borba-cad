;;;; Portuguese (Brazil) translations. Each entry is (ENGLISH TRANSLATION); the English text is the key.
;;;; A translation asks for the same format directives, in the same order, as its English text.
;;;; The file is UTF-8 data: it is read, never evaluated.

(:language :pt-br
 :name "Português (Brasil)"
 :entries
 (
  ;; Title bar and files
  ("Language" "Idioma")
